<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduFlow · LMS Portal</title>
    <!-- Font Awesome 6 (free) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #4f46e5;
            --primary-light: #818cf8;
            --primary-dark: #3730a3;
            --secondary: #0ea5e9;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-300: #d1d5db;
            --gray-400: #9ca3af;
            --gray-500: #6b7280;
            --gray-600: #4b5563;
            --gray-700: #374151;
            --gray-800: #1f2937;
            --gray-900: #111827;
            --radius: 16px;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
            --shadow-lg: 0 20px 50px -12px rgba(0, 0, 0, 0.15);
            --transition: 0.25s ease;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--gray-50);
            color: var(--gray-800);
            display: flex;
            min-height: 100vh;
        }

        /* ----- SCROLLBAR ----- */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--gray-100);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--gray-300);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--gray-400);
        }

        /* ----- SIDEBAR ----- */
        .sidebar {
            width: 260px;
            background: white;
            border-right: 1px solid var(--gray-200);
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
            transition: transform var(--transition);
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 8px 28px 8px;
            border-bottom: 1px solid var(--gray-200);
            margin-bottom: 24px;
        }

        .sidebar-brand .logo-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 22px;
            flex-shrink: 0;
        }

        .sidebar-brand h1 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-nav {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-nav .nav-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--gray-400);
            font-weight: 600;
            padding: 16px 12px 8px 12px;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 12px;
            color: var(--gray-600);
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: all var(--transition);
            cursor: pointer;
        }

        .sidebar-nav a i {
            width: 20px;
            font-size: 16px;
            text-align: center;
        }

        .sidebar-nav a:hover {
            background: var(--gray-100);
            color: var(--gray-800);
        }

        .sidebar-nav a.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .sidebar-nav a.active i {
            color: white;
        }

        .sidebar-nav a .badge {
            margin-left: auto;
            background: var(--gray-200);
            color: var(--gray-700);
            font-size: 11px;
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 30px;
        }

        .sidebar-nav a.active .badge {
            background: rgba(255, 255, 255, 0.2);
            color: white;
        }

        .sidebar-footer {
            border-top: 1px solid var(--gray-200);
            padding-top: 16px;
            margin-top: 8px;
        }

        .sidebar-footer .user-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            border-radius: 12px;
            transition: background var(--transition);
            cursor: pointer;
        }

        .sidebar-footer .user-card:hover {
            background: var(--gray-100);
        }

        .sidebar-footer .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-light), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 16px;
            flex-shrink: 0;
        }

        .sidebar-footer .user-info {
            flex: 1;
            min-width: 0;
        }

        .sidebar-footer .user-info .name {
            font-weight: 600;
            font-size: 14px;
            color: var(--gray-800);
        }

        .sidebar-footer .user-info .role {
            font-size: 12px;
            color: var(--gray-500);
        }

        /* ----- MAIN CONTENT ----- */
        .main {
            margin-left: 260px;
            flex: 1;
            padding: 28px 36px 40px 36px;
            min-height: 100vh;
        }

        /* ----- TOP BAR ----- */
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .topbar-left .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 22px;
            color: var(--gray-600);
            cursor: pointer;
            padding: 4px;
        }

        .topbar-left h2 {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .topbar-left h2 span {
            color: var(--gray-400);
            font-weight: 400;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-right .search-box {
            display: flex;
            align-items: center;
            background: white;
            border: 1px solid var(--gray-200);
            border-radius: 30px;
            padding: 8px 18px 8px 16px;
            gap: 10px;
            transition: all var(--transition);
        }

        .topbar-right .search-box:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
        }

        .topbar-right .search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 14px;
            width: 180px;
            color: var(--gray-700);
        }

        .topbar-right .search-box input::placeholder {
            color: var(--gray-400);
        }

        .topbar-right .search-box i {
            color: var(--gray-400);
            font-size: 14px;
        }

        .topbar-right .icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 1px solid var(--gray-200);
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-600);
            font-size: 18px;
            cursor: pointer;
            transition: all var(--transition);
            position: relative;
        }

        .topbar-right .icon-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: var(--gray-50);
        }

        .topbar-right .icon-btn .dot {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: var(--danger);
            border-radius: 50%;
            border: 2px solid white;
        }

        /* ----- DASHBOARD CARDS ----- */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border-radius: var(--radius);
            padding: 20px 22px;
            box-shadow: var(--shadow);
            border: 1px solid var(--gray-100);
            transition: all var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .stat-card .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 8px;
        }

        .stat-card .stat-top .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .stat-card .stat-top .stat-icon.blue {
            background: #e0e7ff;
            color: var(--primary);
        }
        .stat-card .stat-top .stat-icon.green {
            background: #dcfce7;
            color: var(--success);
        }
        .stat-card .stat-top .stat-icon.yellow {
            background: #fef3c7;
            color: var(--warning);
        }
        .stat-card .stat-top .stat-icon.pink {
            background: #fce7f3;
            color: #db2777;
        }

        .stat-card .stat-number {
            font-size: 28px;
            font-weight: 700;
            color: var(--gray-900);
            letter-spacing: -0.5px;
        }

        .stat-card .stat-label {
            font-size: 14px;
            color: var(--gray-500);
            font-weight: 500;
        }

        .stat-card .stat-change {
            font-size: 13px;
            font-weight: 600;
            margin-top: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .stat-card .stat-change.up {
            color: var(--success);
        }
        .stat-card .stat-change.down {
            color: var(--danger);
        }

        /* ----- SECTION HEADER ----- */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-header h3 {
            font-size: 18px;
            font-weight: 600;
        }

        .section-header .view-all {
            color: var(--primary);
            font-weight: 500;
            font-size: 14px;
            text-decoration: none;
            cursor: pointer;
            transition: color var(--transition);
        }

        .section-header .view-all:hover {
            color: var(--primary-dark);
        }

        /* ----- COURSE GRID ----- */
        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }

        .course-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--gray-100);
            transition: all var(--transition);
        }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .course-card .course-thumb {
            height: 140px;
            background: linear-gradient(135deg, var(--primary-light), var(--secondary));
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 36px;
            opacity: 0.85;
        }

        .course-card .course-thumb .thumb-label {
            position: absolute;
            top: 14px;
            right: 14px;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(4px);
            padding: 4px 14px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: white;
        }

        .course-card .course-body {
            padding: 18px 20px 20px;
        }

        .course-card .course-body .course-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 4px;
        }

        .course-card .course-body .course-instructor {
            font-size: 13px;
            color: var(--gray-500);
            margin-bottom: 14px;
        }

        .course-card .course-body .progress-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .course-card .course-body .progress-bar {
            flex: 1;
            height: 6px;
            background: var(--gray-200);
            border-radius: 10px;
            overflow: hidden;
        }

        .course-card .course-body .progress-bar .fill {
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            width: 0%;
        }

        .course-card .course-body .progress-text {
            font-size: 13px;
            font-weight: 600;
            color: var(--gray-700);
            min-width: 36px;
            text-align: right;
        }

        .course-card .course-body .course-meta {
            display: flex;
            justify-content: space-between;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--gray-100);
            font-size: 13px;
            color: var(--gray-500);
        }

        .course-card .course-body .course-meta span i {
            margin-right: 6px;
        }

        /* ----- ACTIVITY / ASSIGNMENTS TABLE ----- */
        .activity-panel {
            background: white;
            border-radius: var(--radius);
            border: 1px solid var(--gray-100);
            overflow: hidden;
            box-shadow: var(--shadow);
            margin-bottom: 32px;
        }

        .activity-panel .panel-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--gray-100);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .activity-panel .panel-header h4 {
            font-weight: 600;
            font-size: 16px;
        }

        .activity-panel .panel-header .pill-group {
            display: flex;
            gap: 6px;
        }

        .activity-panel .panel-header .pill-group .pill {
            padding: 4px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 500;
            background: var(--gray-100);
            color: var(--gray-600);
            cursor: pointer;
            transition: all var(--transition);
            border: none;
        }

        .activity-panel .panel-header .pill-group .pill.active {
            background: var(--primary);
            color: white;
        }

        .activity-panel .panel-header .pill-group .pill:hover:not(.active) {
            background: var(--gray-200);
        }

        .activity-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .activity-table th {
            text-align: left;
            padding: 14px 24px;
            background: var(--gray-50);
            color: var(--gray-500);
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .activity-table td {
            padding: 16px 24px;
            border-bottom: 1px solid var(--gray-100);
            color: var(--gray-700);
        }

        .activity-table tr:last-child td {
            border-bottom: none;
        }

        .activity-table .status {
            padding: 4px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }

        .activity-table .status.done {
            background: #dcfce7;
            color: #15803d;
        }
        .activity-table .status.pending {
            background: #fef3c7;
            color: #b45309;
        }
        .activity-table .status.overdue {
            background: #fee2e2;
            color: #b91c1c;
        }

        .activity-table .status.in-progress {
            background: #dbeafe;
            color: #1d4ed8;
        }

        /* ----- RESPONSIVE ----- */
        @media (max-width: 1024px) {
            .main {
                padding: 24px 24px 32px;
            }
        }

        @media (max-width: 820px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            .sidebar.open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
                padding: 20px 20px 30px;
            }

            .topbar-left .menu-toggle {
                display: block;
            }

            .topbar-right .search-box input {
                width: 120px;
            }

            .stats-grid {
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            }
        }

        @media (max-width: 520px) {
            .topbar {
                flex-direction: column;
                align-items: stretch;
            }
            .topbar-right {
                flex-wrap: wrap;
            }
            .topbar-right .search-box {
                flex: 1;
            }
            .topbar-right .search-box input {
                width: 100%;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .course-grid {
                grid-template-columns: 1fr;
            }

            .activity-table {
                font-size: 13px;
            }
            .activity-table th,
            .activity-table td {
                padding: 12px 16px;
            }
            .activity-table .hide-mobile {
                display: none;
            }
        }

        /* ----- OVERLAY (mobile) ----- */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.25);
            z-index: 90;
            backdrop-filter: blur(2px);
        }

        .sidebar-overlay.open {
            display: block;
        }

        /* ----- UTILITY ----- */
        .text-primary {
            color: var(--primary);
        }
        .fw-600 {
            font-weight: 600;
        }

        /* simple view toggle (dummy) */
        .view-toggle {
            display: flex;
            gap: 4px;
            background: var(--gray-100);
            padding: 4px;
            border-radius: 30px;
        }

        .view-toggle button {
            border: none;
            background: transparent;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-500);
            cursor: pointer;
            transition: all var(--transition);
        }

        .view-toggle button.active {
            background: white;
            color: var(--gray-800);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
    </style>
</head>
<body>

    <!-- ===== SIDEBAR OVERLAY (mobile) ===== -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
            <h1>EduFlow</h1>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-label">Main</div>
            <a href="#" class="active" data-page="dashboard">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a href="#" data-page="courses">
                <i class="fas fa-book-open"></i> My Courses
                <span class="badge">6</span>
            </a>
            <a href="#" data-page="assignments">
                <i class="fas fa-tasks"></i> Assignments
                <span class="badge">3</span>
            </a>
            <a href="#" data-page="calendar">
                <i class="fas fa-calendar-alt"></i> Calendar
            </a>

            <div class="nav-label">Instructor</div>
            <a href="#" data-page="instructor">
                <i class="fas fa-chalkboard-teacher"></i> Teach
            </a>
            <a href="#" data-page="students">
                <i class="fas fa-users"></i> Students
            </a>

            <div class="nav-label">Settings</div>
            <a href="#" data-page="settings">
                <i class="fas fa-cog"></i> Preferences
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="avatar">JD</div>
                <div class="user-info">
                    <div class="name">James Duncan</div>
                    <div class="role">Student · Instructor</div>
                </div>
                <i class="fas fa-ellipsis-v" style="color: var(--gray-400); font-size: 14px;"></i>
            </div>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="main" id="mainContent">

        <!-- TOPBAR -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" id="menuToggle" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <h2>Dashboard <span>/ overview</span></h2>
            </div>
            <div class="topbar-right">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search courses..." />
                </div>
                <button class="icon-btn" aria-label="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="dot"></span>
                </button>
                <button class="icon-btn" aria-label="Messages">
                    <i class="fas fa-envelope"></i>
                </button>
            </div>
        </header>

        <!-- STATS -->
        <section class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Enrolled Courses</span>
                    <span class="stat-icon blue"><i class="fas fa-book"></i></span>
                </div>
                <div class="stat-number">12</div>
                <div class="stat-change up"><i class="fas fa-arrow-up"></i> +2 this month</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Completed</span>
                    <span class="stat-icon green"><i class="fas fa-check-circle"></i></span>
                </div>
                <div class="stat-number">8</div>
                <div class="stat-change up"><i class="fas fa-arrow-up"></i> 66% completion</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Pending Assignments</span>
                    <span class="stat-icon yellow"><i class="fas fa-clock"></i></span>
                </div>
                <div class="stat-number">5</div>
                <div class="stat-change down"><i class="fas fa-arrow-down"></i> 2 overdue</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <span class="stat-label">Avg. Score</span>
                    <span class="stat-icon pink"><i class="fas fa-star"></i></span>
                </div>
                <div class="stat-number">84%</div>
                <div class="stat-change up"><i class="fas fa-arrow-up"></i> +5% from last term</div>
            </div>
        </section>

        <!-- COURSES -->
        <div class="section-header">
            <h3>My Courses</h3>
            <div style="display: flex; gap: 12px; align-items: center;">
                <div class="view-toggle">
                    <button class="active"><i class="fas fa-th"></i></button>
                    <button><i class="fas fa-list"></i></button>
                </div>
                <a href="#" class="view-all">See all <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <div class="course-grid" id="courseGrid">
            <!-- Course cards will be injected by JS -->
        </div>

        <!-- ACTIVITY / ASSIGNMENTS -->
        <div class="section-header">
            <h3>Recent Assignments</h3>
            <a href="#" class="view-all">View all <i class="fas fa-arrow-right"></i></a>
        </div>

        <div class="activity-panel">
            <div class="panel-header">
                <h4><i class="fas fa-clipboard-list" style="margin-right: 8px; color: var(--primary);"></i> Due This Week</h4>
                <div class="pill-group">
                    <button class="pill active">All</button>
                    <button class="pill">Pending</button>
                    <button class="pill">Completed</button>
                </div>
            </div>
            <table class="activity-table">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th class="hide-mobile">Course</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="assignmentTableBody">
                    <!-- Injected by JS -->
                </tbody>
            </table>
        </div>

        <!-- FOOTER NOTE -->
        <div style="text-align: center; font-size: 13px; color: var(--gray-400); padding: 12px 0 4px; border-top: 1px solid var(--gray-200);">
            &copy; 2026 EduFlow · Learning Management Portal
        </div>
    </main>

    <script>
        // ============================================================
        //  DATA
        // ============================================================
        const courses = [{
            id: 1,
            title: 'UI/UX Design Principles',
            instructor: 'Dr. Sarah Chen',
            progress: 78,
            lessons: 24,
            students: 143,
            color: 'from-indigo-500 to-purple-500'
        }, {
            id: 2,
            title: 'Full-Stack Web Development',
            instructor: 'Prof. Michael Torres',
            progress: 45,
            lessons: 42,
            students: 267,
            color: 'from-cyan-500 to-blue-500'
        }, {
            id: 3,
            title: 'Data Science & Machine Learning',
            instructor: 'Dr. Emily Park',
            progress: 92,
            lessons: 36,
            students: 198,
            color: 'from-emerald-500 to-teal-500'
        }, {
            id: 4,
            title: 'Digital Marketing Strategy',
            instructor: 'Prof. Lisa Wong',
            progress: 33,
            lessons: 18,
            students: 94,
            color: 'from-rose-500 to-orange-500'
        }, {
            id: 5,
            title: 'Cloud Computing (AWS)',
            instructor: 'James Carter',
            progress: 61,
            lessons: 30,
            students: 156,
            color: 'from-yellow-500 to-amber-500'
        }, {
            id: 6,
            title: 'Leadership & Management',
            instructor: 'Dr. Robert Hayes',
            progress: 12,
            lessons: 20,
            students: 112,
            color: 'from-violet-500 to-fuchsia-500'
        }];

        const assignments = [{
            title: 'Design System Prototype',
            course: 'UI/UX Design Principles',
            due: '2026-07-18',
            status: 'pending'
        }, {
            title: 'React Hook Form Validation',
            course: 'Full-Stack Web Development',
            due: '2026-07-16',
            status: 'done'
        }, {
            title: 'Linear Regression Report',
            course: 'Data Science & ML',
            due: '2026-07-20',
            status: 'in-progress'
        }, {
            title: 'Social Media Campaign Plan',
            course: 'Digital Marketing Strategy',
            due: '2026-07-14',
            status: 'overdue'
        }, {
            title: 'AWS S3 Bucket Setup',
            course: 'Cloud Computing (AWS)',
            due: '2026-07-22',
            status: 'pending'
        }];

        const statusMap = {
            'done': 'Done',
            'pending': 'Pending',
            'overdue': 'Overdue',
            'in-progress': 'In Progress'
        };

        const statusClassMap = {
            'done': 'done',
            'pending': 'pending',
            'overdue': 'overdue',
            'in-progress': 'in-progress'
        };

        // ============================================================
        //  RENDER FUNCTIONS
        // ============================================================

        function renderCourses() {
            const grid = document.getElementById('courseGrid');
            grid.innerHTML = courses.map(c => {
                const iconMap = {
                    'UI/UX Design Principles': 'fa-paint-brush',
                    'Full-Stack Web Development': 'fa-code',
                    'Data Science & Machine Learning': 'fa-database',
                    'Digital Marketing Strategy': 'fa-chart-line',
                    'Cloud Computing (AWS)': 'fa-cloud',
                    'Leadership & Management': 'fa-users-cog'
                };
                const icon = iconMap[c.title] || 'fa-book';
                // generate a nice gradient background
                const gradient = c.color || 'from-indigo-500 to-purple-500';
                return `
                        <div class="course-card">
                            <div class="course-thumb" style="background: linear-gradient(135deg, var(--primary-light), var(--secondary));">
                                <i class="fas ${icon}"></i>
                                <span class="thumb-label">${c.lessons} lessons</span>
                            </div>
                            <div class="course-body">
                                <div class="course-title">${c.title}</div>
                                <div class="course-instructor"><i class="fas fa-user-graduate" style="margin-right: 6px;"></i>${c.instructor}</div>
                                <div class="progress-wrap">
                                    <div class="progress-bar">
                                        <div class="fill" style="width: ${c.progress}%;"></div>
                                    </div>
                                    <span class="progress-text">${c.progress}%</span>
                                </div>
                                <div class="course-meta">
                                    <span><i class="fas fa-user"></i> ${c.students} students</span>
                                    <span><i class="fas fa-clock"></i> ${c.progress < 50 ? 'In progress' : c.progress < 90 ? 'Almost there' : 'Complete'}</span>
                                </div>
                            </div>
                        </div>
                    `;
            }).join('');
        }

        function renderAssignments() {
            const tbody = document.getElementById('assignmentTableBody');
            tbody.innerHTML = assignments.map(a => {
                const statusLabel = statusMap[a.status] || a.status;
                const statusClass = statusClassMap[a.status] || 'pending';
                // format date nicely
                const d = new Date(a.due + 'T00:00:00');
                const dateStr = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                return `
                        <tr>
                            <td><span class="fw-600">${a.title}</span></td>
                            <td class="hide-mobile">${a.course}</td>
                            <td>${dateStr}</td>
                            <td><span class="status ${statusClass}">${statusLabel}</span></td>
                        </tr>
                    `;
            }).join('');
        }

        // ============================================================
        //  SIDEBAR TOGGLE (mobile)
        // ============================================================
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const menuToggle = document.getElementById('menuToggle');

        function toggleSidebar() {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
        }

        menuToggle.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', toggleSidebar);

        // close sidebar on link click (mobile)
        document.querySelectorAll('.sidebar-nav a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                // active state
                document.querySelectorAll('.sidebar-nav a').forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                // update heading
                const page = this.dataset.page || 'dashboard';
                const heading = document.querySelector('.topbar-left h2');
                const pageNames = {
                    dashboard: 'Dashboard',
                    courses: 'My Courses',
                    assignments: 'Assignments',
                    calendar: 'Calendar',
                    instructor: 'Instructor Panel',
                    students: 'Students',
                    settings: 'Settings'
                };
                if (heading) {
                    const name = pageNames[page] || 'Dashboard';
                    heading.innerHTML = `${name} <span>/ ${page}</span>`;
                }

                // close sidebar on mobile
                if (window.innerWidth <= 820) {
                    toggleSidebar();
                }
            });
        });

        // ============================================================
        //  PILL FILTER (dummy)
        // ============================================================
        document.querySelectorAll('.pill-group .pill').forEach(pill => {
            pill.addEventListener('click', function() {
                document.querySelectorAll('.pill-group .pill').forEach(p => p.classList.remove('active'));
                this.classList.add('active');
                // In a real app you'd filter here
            });
        });

        // ============================================================
        //  VIEW TOGGLE (dummy)
        // ============================================================
        document.querySelectorAll('.view-toggle button').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.view-toggle button').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                // could switch grid/list view
            });
        });

        // ============================================================
        //  INIT
        // ============================================================
        renderCourses();
        renderAssignments();

        // Handle window resize to close sidebar if needed
        window.addEventListener('resize', () => {
            if (window.innerWidth > 820 && sidebar.classList.contains('open')) {
                sidebar.classList.remove('open');
                overlay.classList.remove('open');
            }
        });

        console.log('🚀 EduFlow LMS Portal ready.');
    </script>

</body>
</html>